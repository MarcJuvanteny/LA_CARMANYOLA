{
  "name": "la-carmanyola",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed && npm run sim:seed",
    "db:seed": "tsx scripts/base-seed.ts",
    "test": "vitest run",
    "sim:seed": "tsx --env-file=.env.local scripts/sim-seed.ts",
    "sim:tick": "tsx --env-file=.env.local scripts/sim-tick.ts",
    "sim:report": "tsx --env-file=.env.local scripts/sim-report.ts",
    "sim:reset-demo": "tsx --env-file=.env.local scripts/sim-reset-demo.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
